#! /usr/bin/env node
import yargs from 'yargs';
import path from 'path';
import chcpContext from '../dist/context.js';

const argv = yargs.argv;

function printUsage() {
  console.log('Usage: cordova-hcp <command>');
  console.log('Commands:');
  console.log('  build - Build the project');
  console.log('  init - Initialize the project');
  console.log('  help - Show help');
  process.exit(0);
}

var cmd = argv[0];
switch(cmd) {
  case 'build':
  case 'init':
    console.log('Running ' + cmd);
    var command = require(path.resolve(__dirname, '..', 'dist', cmd + '.js')),
        context = chcpContext.context(argv);
    command.execute(context);
    break;
  case 'help':
    printUsage();
    break;
  default:
    console.error('Unknown command: ' + cmd);
    printUsage();
}
