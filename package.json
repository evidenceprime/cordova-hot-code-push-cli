{
  "name": "cordova-hot-code-push-cli",
  "version": "1.2.2",
  "description": "Cordova Hot Code Push CLI",
  "preferGlobal": "true",
  "bin": {
    "cordova-hcp": "bin/cordova-hcp"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evidenceprime/cordova-hot-code-push-cli.git"
  },
  "keywords": [
    "cordova",
    "nordnet",
    "mobile",
    "cordova-hot-code-push-plugin",
    "ecosystem:cordova",
    "cordova-android",
    "cordova-ios"
  ],
  "scripts": {
    "pretranspile": "rimraf dist",
    "transpile": "babel src --out-dir dist",
    "dev": "npm run transpile -- --watch",
    "test": "mocha"
  },
  "author": "Andreas Hassellöf for Nordnet Bank AB",
  "license": "MIT",
  "dependencies": {
    "async": "3.2.6",
    "es6-promise": "4.2.8",
    "fs-extra": "11.3.5",
    "hidefile": "3.0.0",
    "lodash": "4.18.1",
    "prompt": "1.3.0",
    "q": "1.5.1",
    "recursive-readdir": "2.2.3",
    "yargs": "18.0.0"
  },
  "devDependencies": {
    "babel-cli": "6.26.0",
    "rimraf": "6.1.3"
  }
}
